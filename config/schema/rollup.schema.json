{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nishikantmandal007/osdagbridge-pm/config/schema/rollup.schema.json",
  "title": "All Projects roll-up board config",
  "description": "The portfolio board: reuses base fields/views and adds one Software field whose options are the listed projects.",
  "type": "object",
  "required": ["version", "project", "software", "software_field"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "project": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "short_description": {"type": "string"}
      }
    },
    "software": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[a-z0-9-]+$"},
      "uniqueItems": true
    },
    "software_field": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "type": {"type": "string", "enum": ["SINGLE_SELECT"]},
        "color": {"type": "string"}
      }
    }
  }
}
