{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OsdagBridge epics config",
  "type": "object",
  "required": ["version", "epics"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "integer", "const": 1},
    "marker_prefix": {"type": "string", "minLength": 1},
    "epics": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/epic"}
    }
  },
  "$defs": {
    "epic": {
      "type": "object",
      "required": ["code", "title", "outcome", "release", "areas"],
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "outcome": {"type": "string", "minLength": 1},
        "release": {"type": "string", "minLength": 1},
        "areas": {
          "type": "array",
          "items": {"type": "string", "pattern": "^area:"}
        },
        "sub_epics": {
          "type": "array",
          "items": {"$ref": "#/$defs/subepic"}
        }
      }
    },
    "subepic": {
      "type": "object",
      "required": ["slug", "title"],
      "additionalProperties": false,
      "properties": {
        "slug": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "title": {"type": "string", "minLength": 1},
        "areas": {
          "type": "array",
          "items": {"type": "string", "pattern": "^area:"}
        }
      }
    }
  }
}
