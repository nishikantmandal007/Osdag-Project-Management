{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nishikantmandal007/osdagbridge-pm/config/schema/software.schema.json",
  "title": "Per-project overlay config",
  "description": "The project-specific half of a board: display name, area labels, epics, source repos, and release channels. Merged with config/base.yml by project_management.config.load_merged.",
  "type": "object",
  "required": ["version", "name", "display_name", "short_description", "source_repos", "area_labels", "epics"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "name": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "display_name": {"type": "string", "minLength": 1},
    "short_description": {"type": "string"},
    "board_number": {"type": ["integer", "null"], "minimum": 1},
    "logo": {"type": "string"},
    "source_repos": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
      "uniqueItems": true
    },
    "conda_channels": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "migrations": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "area_labels": {"$ref": "#/$defs/namespace"},
    "epics": {
      "type": "object",
      "required": ["items"],
      "additionalProperties": false,
      "properties": {
        "marker_prefix": {"type": "string", "minLength": 1},
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/epic"}
        }
      }
    }
  },
  "$defs": {
    "color": {"type": "string", "pattern": "^[0-9a-fA-F]{6}$"},
    "namespace": {
      "type": "object",
      "required": ["labels"],
      "additionalProperties": false,
      "properties": {
        "description": {"type": "string"},
        "color": {"$ref": "#/$defs/color"},
        "labels": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/label"}
        }
      }
    },
    "label": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 50, "pattern": "^area:"},
        "description": {"type": "string", "maxLength": 100},
        "color": {"$ref": "#/$defs/color"},
        "alias": {"type": "string", "minLength": 1, "maxLength": 50}
      }
    },
    "epic": {
      "type": "object",
      "required": ["code", "title", "outcome", "release", "areas"],
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "outcome": {"type": "string", "minLength": 1},
        "release": {"type": "string", "minLength": 1},
        "areas": {
          "type": "array",
          "items": {"type": "string", "pattern": "^area:"}
        },
        "sub_epics": {
          "type": "array",
          "items": {"$ref": "#/$defs/subepic"}
        }
      }
    },
    "subepic": {
      "type": "object",
      "required": ["slug", "title"],
      "additionalProperties": false,
      "properties": {
        "slug": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "title": {"type": "string", "minLength": 1},
        "areas": {
          "type": "array",
          "items": {"type": "string", "pattern": "^area:"}
        }
      }
    }
  }
}
