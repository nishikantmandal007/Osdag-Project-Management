{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nishikantmandal007/osdagbridge-pm/config/schema/labels.schema.json",
  "title": "Label taxonomy",
  "description": "Validated before any GitHub call. A malformed config must fail locally, not halfway through mutating a live tracker.",
  "type": "object",
  "required": ["version", "namespaces"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "namespaces": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z]+$",
        "description": "Namespace prefix; label names must start with '<namespace>:'"
      },
      "additionalProperties": { "$ref": "#/$defs/namespace" }
    },
    "migrations": {
      "type": "object",
      "description": "Upstream label name -> new taxonomy label name.",
      "additionalProperties": { "$ref": "#/$defs/labelName" }
    },
    "protected": {
      "type": "array",
      "description": "Never created, updated, renamed or reported. GitHub defaults and third-party tooling labels.",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{6}$",
      "description": "Six hex digits, no leading '#'."
    },
    "labelName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "description": "GitHub caps label names at 50 characters."
    },
    "namespace": {
      "type": "object",
      "required": ["labels"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "color": {
          "$ref": "#/$defs/color",
          "description": "Default for every label in the namespace; a label may override it."
        },
        "labels": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/label" }
        }
      }
    },
    "label": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/labelName" },
        "description": { "type": "string", "maxLength": 100 },
        "color": { "$ref": "#/$defs/color" },
        "alias": {
          "$ref": "#/$defs/labelName",
          "description": "Former name. Renamed in place to preserve issue associations; never create-and-delete."
        },
        "triage_sla": { "type": "string" },
        "fix_sla": { "type": "string" }
      }
    }
  }
}
